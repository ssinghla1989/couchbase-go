# Base application settings
APP_ENV=e0
LOG_LEVEL=info
SERVER_PORT=8080
SERVER_READ_TIMEOUT=15s
SERVER_WRITE_TIMEOUT=15s
SERVER_IDLE_TIMEOUT=60s
SHUTDOWN_TIMEOUT=20s
REQUEST_TIMEOUT=30s
CORS_ALLOWED_ORIGINS=*

# Legacy single Couchbase settings (used by current code)
CB_CONN_STR=couchbase://localhost
CB_USERNAME=Administrator
CB_PASSWORD=password
CB_BUCKET=default
CB_TIMEOUT=10s

# Optional multi-cluster Couchbase settings (for IPCs)
IPC1_CB_CONN_STR=couchbase://localhost
IPC1_CB_USERNAME=Administrator
IPC1_CB_PASSWORD=password
IPC1_CB_BUCKET=default

IPC2_CB_CONN_STR=couchbase://localhost
IPC2_CB_USERNAME=Administrator
IPC2_CB_PASSWORD=password
IPC2_CB_BUCKET=default
