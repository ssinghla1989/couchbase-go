            "delete": {
                "description": "Delete a document. If `If-Match:\"\u003ccas\u003e\"` header (or body `if_match_cas`) is provided, the delete is CAS-protected. When `REQUIRE_CAS_ON_DELETE=true`, missing CAS returns 428.",
