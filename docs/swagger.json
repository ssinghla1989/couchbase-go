                "responses": {
                    "200": {
                        "description": "OK",
                        "schema": {
                            "type": "object",
                            "additionalProperties": true
                        },
                        "headers": {
                            "ETag": {
                                "type": "string",
                                "description": "CAS ETag of the document (quoted)"
                            }
                        }
