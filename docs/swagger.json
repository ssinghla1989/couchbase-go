{
    "swagger": "2.0",
    "info": {
        "description": "REST API with Couchbase (gocb v2), chi router, zap logging.",
        "title": "Couchbase Go API",
        "contact": {},
        "version": "1.0"
    },
    "basePath": "/",
    "paths": {
        "/buckets/{bucket}/docs": {
            "post": {
                "description": "Create a new document with server-generated UUID",
                "consumes": [
                    "application/json"
                ],
                "produces": [
                    "application/json"
                ],
                "summary": "Create document",
                "parameters": [
                    {
                        "type": "string",
                        "description": "Bucket name",
                        "name": "bucket",
                        "in": "path",
                        "required": true
                    },
                    {
                        "type": "string",
                        "description": "Scope name",
                        "name": "scope",
                        "in": "query"
                    },
                    {
                        "type": "string",
                        "description": "Collection name",
                        "name": "collection",
                        "in": "query"
                    },
                    {
                        "type": "string",
                        "description": "ID prefix",
                        "name": "prefix",
                        "in": "query"
                    }
                ],
                "responses": {
                    "201": {
                        "description": "Created",
                        "schema": {
                            "type": "object",
                            "additionalProperties": {
                                "type": "string"
                            }
                        },
                        "headers": {
                            "ETag": {
                                "type": "string",
                                "description": "CAS ETag of the created document (quoted)"
                            }
                        }
                    },
                    "400": {
                        "description": "Bad Request",
                        "schema": {
                            "type": "object",
                            "additionalProperties": true
                        }
                    },
                    "503": {
                        "description": "Service Unavailable",
                        "schema": {
                            "type": "object",
                            "additionalProperties": true
                        }
                    }
                }
            }
        },
        "/buckets/{bucket}/docs/_bulk_get": {
            "post": {
                "description": "Best-effort fetch multiple documents; per-item result included. 200 even with partial failures.",
                "consumes": [
                    "application/json"
                ],
                "produces": [
                    "application/json"
                ],
                "summary": "Bulk get documents",
                "parameters": [
                    {
                        "type": "string",
                        "description": "Bucket name",
                        "name": "bucket",
                        "in": "path",
                        "required": true
                    },
                    {
                        "type": "string",
                        "description": "Scope name (default _default)",
                        "name": "scope",
                        "in": "query"
                    },
                    {
                        "type": "string",
                        "description": "Collection name (default _default)",
                        "name": "collection",
                        "in": "query"
                    },
                    {
                        "description": "Bulk get request",
                        "name": "request",
                        "in": "body",
                        "required": true,
                        "schema": {
                            "$ref": "#/definitions/handlers.bulkGetRequest"
                        }
                    }
                ],
                "responses": {
                    "200": {
                        "description": "OK",
                        "schema": {
                            "$ref": "#/definitions/handlers.bulkGetResponse"
                        }
                    },
                    "400": {
                        "description": "Bad Request",
                        "schema": {
                            "type": "object",
                            "additionalProperties": true
                        }
                    },
                    "503": {
                        "description": "Service Unavailable",
                        "schema": {
                            "type": "object",
                            "additionalProperties": true
                        }
                    }
                }
            }
        },
        "/buckets/{bucket}/docs/_bulk_upsert": {
            "post": {
                "description": "Best-effort upsert multiple documents; per-item result included. 200 even with partial failures.",
